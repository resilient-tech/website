# Email Configuration
AWS_SES_ACCESS_KEY_ID=your-ses-access-key-id
AWS_SES_ACCESS_KEY_SECRET=your-ses-secret-access-key
MAIL_SENDER=no-reply@resilient.tech
# Comma-separated lists
CONTACT_US_RECIPIENTS=contact@example.com
JOB_APPLICATION_RECIPIENTS=careers@example.com

# ALTCHA Configuration
# Generate a strong random secret key for production
# Example: openssl rand -base64 32
ALTCHA_SECRET_KEY=your-secret-key-here-generate-a-strong-random-key

# Note: Keep this secret! Never commit it to version control.
# Add it to your Netlify environment variables:
# Site settings > Environment variables > Add a variable
